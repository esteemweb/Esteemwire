# Template only: copy to .env.local for local testing and fill in.
# Real values go in Vercel > Project > Settings > Environment Variables.
# Never put a real key in this file; it is committed to the repo.

# Resend API key, used by the contact form (app/actions.ts) to email
# enquiries. Create it at resend.com > API Keys, with "Sending access".
# Server-only: do NOT add a NEXT_PUBLIC_ prefix.
RESEND_API_KEY=
